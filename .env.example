# Copy to .env.local. All values are optional in development.

# Postgres connection string. Leave empty to use the embedded PGlite file DB at ./.data/pglite.
DATABASE_URL=

# Secret for signing session cookies (32+ random characters). A dev fallback is used, with a warning, if empty.
SESSION_SECRET=

# Public base URL used in QR codes and WhatsApp links. Production: https://classnest.craftlayer.store
APP_URL=http://localhost:3150

# Show the OTP on screen (demo mode). Defaults to on outside production.
DEMO_OTP=

# Shared secret for the scheduler calling POST /api/cron (absence alerts and fee reminders).
CRON_SECRET=
